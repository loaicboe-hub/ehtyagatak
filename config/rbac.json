{
  "version": "1.1.0",
  "enforcement": "server_side_mandatory",
  "defaultRoleForNewAdminCreatedUsers": "editor",
  "permissionsCatalog": [
    "dashboard.overview.view",
    "content.view",
    "content.edit",
    "pages.view",
    "pages.create",
    "pages.edit",
    "pages.publish",
    "pages.delete",
    "media.view",
    "media.upload",
    "media.replace",
    "media.delete",
    "settings.website.view",
    "settings.website.edit",
    "settings.contact.view",
    "settings.contact.edit",
    "settings.calculator.edit",
    "seo.view",
    "seo.edit",
    "translations.view",
    "translations.edit",
    "translations.verify",
    "inquiries.view",
    "inquiries.manage",
    "users.view",
    "users.create",
    "users.edit",
    "users.toggle_active",
    "roles.view",
    "roles.manage",
    "security.logs.view",
    "audit.logs.view",
    "account.self.manage",
    "modules.manage",
    "investors.view",
    "investors.manage",
    "approvals.view",
    "approvals.review",
    "support.view",
    "support.manage",
    "erp.logs.view",
    "portal.access"
  ],
  "roles": {
    "super_admin": {
      "label": "Super Admin",
      "description": "Full system control including roles, permissions, users, website settings, approvals, investors, and security/audit logs.",
      "isSystemRole": true,
      "permissions": ["*"]
    },
    "admin": {
      "label": "Admin",
      "description": "Manages website content, pages, media, SEO, website settings, calculator defaults, leads, investors, approvals, and standard users without altering super-admin roles.",
      "isSystemRole": true,
      "permissions": [
        "dashboard.overview.view",
        "content.view",
        "content.edit",
        "pages.view",
        "pages.create",
        "pages.edit",
        "pages.publish",
        "media.view",
        "media.upload",
        "media.replace",
        "settings.website.view",
        "settings.website.edit",
        "settings.contact.view",
        "settings.contact.edit",
        "settings.calculator.edit",
        "seo.view",
        "seo.edit",
        "translations.view",
        "translations.edit",
        "translations.verify",
        "inquiries.view",
        "inquiries.manage",
        "users.view",
        "users.create",
        "users.edit",
        "users.toggle_active",
        "roles.view",
        "security.logs.view",
        "audit.logs.view",
        "account.self.manage",
        "modules.manage",
        "investors.view",
        "investors.manage",
        "approvals.view",
        "approvals.review",
        "support.view",
        "support.manage",
        "erp.logs.view"
      ]
    },
    "editor": {
      "label": "Editor",
      "description": "Creates and edits website content, pages, projects, news, FAQs, media, translations, and page SEO without modifying global website settings or financial/investor records.",
      "isSystemRole": true,
      "permissions": [
        "dashboard.overview.view",
        "content.view",
        "content.edit",
        "pages.view",
        "pages.create",
        "pages.edit",
        "media.view",
        "media.upload",
        "media.replace",
        "seo.view",
        "seo.edit",
        "translations.view",
        "translations.edit",
        "inquiries.view",
        "account.self.manage",
        "modules.manage"
      ]
    },
    "investor_manager": {
      "label": "Investor Manager",
      "description": "Manages investor accounts, greenhouse/contract allocations, leads/appointments, support tickets, and reviews/approves operational, installment, and profit records.",
      "isSystemRole": true,
      "permissions": [
        "dashboard.overview.view",
        "inquiries.view",
        "inquiries.manage",
        "investors.view",
        "investors.manage",
        "approvals.view",
        "approvals.review",
        "support.view",
        "support.manage",
        "media.view",
        "media.upload",
        "erp.logs.view",
        "audit.logs.view",
        "account.self.manage"
      ]
    },
    "investor": {
      "label": "Investor",
      "description": "Private Investor Portal user with strict row-level isolation to view only their own approved investments, greenhouses, crops, profits, installments, documents, and support tickets.",
      "isSystemRole": true,
      "permissions": [
        "portal.access",
        "account.self.manage"
      ]
    }
  },
  "customRolesPolicy": {
    "allowProjectSpecificRoles": true,
    "protectSuperAdminAccounts": "Non-super_admin users cannot edit, deactivate, or reset credentials of super_admin accounts.",
    "preventPrivilegeEscalation": "Users cannot assign roles or permissions higher than their own privilege level; only super_admin may grant wildcard or role-management permissions."
  }
}
